[
  {
    "id": "serverPreset",
    "label": "服务端规则预设",
    "group": "服务端预设",
    "source": "virtual",
    "type": "select",
    "options": [
      {
        "value": "CUSTOM",
        "label": "自定义（CUSTOM）"
      },
      {
        "value": "NORMAL",
        "label": "普通（NORMAL）"
      },
      {
        "value": "HARDCORE",
        "label": "硬核（HARDCORE）"
      }
    ],
    "defaultValue": "CUSTOM",
    "hint": "普通／硬核使用游戏预设规则；自定义使用下方细项设置。保存后重启游戏服生效。"
  },
  {
    "id": "serverName",
    "label": "服务器名称",
    "group": "连接与人数",
    "source": "settings",
