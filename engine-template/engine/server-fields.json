    "source": "settings",
    "key": "advertiseAddress",
    "type": "ipv4",
    "hint": "仅本机游玩填 127.0.0.1；联机填主机组网网卡或局域网 IP。修改后需重启全部服务。",
    "defaultValue": "127.0.0.1"
  },
  {
    "id": "gamePort",
